# The server's /opt/shiftdesk/.env (docs/runbooks.md "Deploy"): every value deploy/docker-compose.yml
# uses. Copy it there, fill it in, then `chmod 600 .env` (root only). Never commit the filled-in
# file. A value with $, # or spaces in it goes in single quotes.

# The image GitHub Actions builds (.github/workflows/deploy.yml): ghcr.io/<owner>/<repo>, lowercase.
SHIFTDESK_IMAGE=ghcr.io/owner/repo
# "main" for the latest; a commit's SHA to pin one (docs/runbooks.md "Rollback").
SHIFTDESK_TAG=main

# Our domain: firms get <slug>.<this>. No port.
APP_BASE_DOMAIN=shiftdesk.co.uk
# For Let's Encrypt's notices about certificates.
ACME_EMAIL=you@yourdomain

# 32+ random characters: openssl rand -base64 32
SESSION_SECRET=
# The planner API's secret (docs/runbooks.md "The planner integration secret"): a different 32+
# random characters, openssl rand -base64 32. Empty: every planner API call answers 503.
INTEGRATIONS_SECRET=

# The database: the host's managed Postgres 16 (its control panel shows the address). The owner's
# password is the admin password the host gave you (percent-encode #, ?, % in these addresses). The
# app and jobs passwords are new ones you choose (openssl rand -hex 24): the migrate step creates
# those two roles with them. Keep the ending as it is: the connection is encrypted and the
# database's certificate checked against the host's CA certificate, saved as secrets/db-ca.pem
# next to this file and readable (chmod 644: it's a public certificate, not a secret; the app runs
# as an ordinary user). The services see it at /app/db-ca.pem. The app refuses to start in
# production without the ending, and Docker without the file. After replacing the file, restart:
# docker compose up -d --force-recreate.
DATABASE_ADMIN_URL=postgres://shiftdesk_owner:OWNER_PASSWORD@DB_ADDRESS:5432/shiftdesk?sslmode=verify-full&sslrootcert=/app/db-ca.pem
DATABASE_URL=postgres://shiftdesk_app:APP_PASSWORD@DB_ADDRESS:5432/shiftdesk?sslmode=verify-full&sslrootcert=/app/db-ca.pem
DATABASE_JOBS_URL=postgres://shiftdesk_jobs:JOBS_PASSWORD@DB_ADDRESS:5432/shiftdesk?sslmode=verify-full&sslrootcert=/app/db-ca.pem

# The job worker: off until the Twilio sender exists ("console" messaging is refused in production,
# by design, so it couldn't start). Then set COMPOSE_PROFILES=worker, MESSAGING_TRANSPORT=twilio
# and the Twilio values (PLAN.md Parking lot, "Connect Twilio"). Until then web and Caddy run.
COMPOSE_PROFILES=
MESSAGING_TRANSPORT=
TWILIO_AUTH_TOKEN=

# Email, sent by the worker over SMTP (docs/runbooks.md "Email not arriving"). smtp is the only
# choice in production. Fill these in from your email provider ("Connect an email provider
# (SMTP)" in PLAN.md): its SMTP server name, port 587 (or 465 if it says "SSL/TLS"), the login it
# gives you, and an address on your own domain that it has verified. Until then the worker refuses
# to start, which it can't yet anyway (it waits for Twilio, above).
EMAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# AI: Claude through the Anthropic API, asked by the worker only (docs/architecture.md "Where AI is
# used"). Off (none) until "Connect the Anthropic API" in PLAN.md: then anthropic, with an API key
# made in a workspace with a monthly spend limit. Off, every message no keyword matches goes to the
# office, and payroll's groups have the app's own line only. AI_MODEL empty means Haiku
# (claude-haiku-4-5).
AI_TRANSPORT=none
ANTHROPIC_API_KEY=
AI_MODEL=

# Postcodes and travel times (docs/office-v2.md 5.4): fake knows only the made-up ZZ postcodes (a
# demo). A real firm needs traveltime (postcodes.io for postcodes, TravelTime for times) once
# "Connect postcodes.io and TravelTime" in PLAN.md is done.
TRAVEL_PROVIDER=fake
# With traveltime: the worker's TravelTime keys (12G.2; secrets: only here, never in the repo).
TRAVELTIME_APP_ID=
TRAVELTIME_API_KEY=

# The phones' offline copy of My shifts: on. "off" switches it off on every phone (docs/runbooks.md
# "A bad service worker").
OFFLINE_COPY=on

# The planner's webhooks (docs/integrations.md), sent by the worker: https is the only choice in
# production (the worker also needs INTEGRATIONS_SECRET, above).
WEBHOOK_TRANSPORT=https

# Web push: none until the keys are made (with the image's own copy of web-push:
# docker compose run --rm --no-deps web node_modules/.bin/web-push generate-vapid-keys); then
# webpush, with all three. The private key is a secret: only the worker gets it.
PUSH_TRANSPORT=none
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Google Sheets: none until "Connect the real Google Sheets" (PLAN.md Parking lot); then google,
# with the key file in secrets/ next to this file (the worker sees it at /app/secrets).
SHEETS_TRANSPORT=none
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=
# Alerts to you (docs/runbooks.md "Alerts from the app"): "console" writes them in the log
# (docker compose logs web worker | grep "ops alert") until the phone sender is connected
# (PLAN.md Parking lot, "Connect alerts to your phone").
ALERTS_TRANSPORT=console
