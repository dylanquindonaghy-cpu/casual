# --- App ---
NODE_ENV=development
APP_BASE_DOMAIN=localhost:3000          # prod: your domain, firms get <slug>.<domain>
SESSION_SECRET=dev-only-secret-change-me-in-prod-0123456789  # 32+ characters. Prod: openssl rand -base64 32
# The planner API's secret (docs/office-v2.md 5.3.6): 32+ characters; unset, every call answers 503.
INTEGRATIONS_SECRET=dev-only-integrations-secret-change-me-0123  # Prod: openssl rand -base64 32
# The planner's webhooks (worker only): console prints them; https sends them (production only).
WEBHOOK_TRANSPORT=console
# The secret store's key (worker and npm run firm:secret only; P5.1): openssl rand -base64 32
# SECRETS_KEY=
# OFFLINE_COPY=on                     # the offline copy of My shifts; unset: on in production only

# --- Database ---
# Three roles (docs/decisions.md ADR-011). Tests use the same URLs with "_test" added to the
# database name; the test database is recreated on every run.
# App role: the web and the worker's data access. No superuser, no BYPASSRLS, owns nothing.
DATABASE_URL=postgres://shiftdesk_app:app_dev_password@localhost:5432/shiftdesk
# Jobs role: the worker's pg-boss connection only. Never give it to the web.
DATABASE_JOBS_URL=postgres://shiftdesk_jobs:jobs_dev_password@localhost:5432/shiftdesk
# Owner: migrations, seed and db:reset only; never the web or worker. Locally this logs in as the
# Docker superuser and switches to the non-superuser owner role, so migrations behave as they will
# on the host's managed Postgres. Production: that database's admin user, used only by the one-off
# migrate step.
DATABASE_ADMIN_URL=postgres://shiftdesk:shiftdesk@localhost:5432/shiftdesk?options=-c%20role%3Dshiftdesk_owner

# --- Messaging ---
MESSAGING_TRANSPORT=console             # console | none (no text sender, P2.5)
# CONSOLE_OUTBOX_FILE=.dev/outbox.jsonl # console transport only: also write each message here (under .dev/)
# DEMO_MODE=on # a demo server only (docs/runbooks.md "A demo server"): messages show on each demo firm's Demo phone (/demo) instead of going out; needs CONSOLE_OUTBOX_FILE
# DEMO_SITE_PASSWORD= # with DEMO_MODE=on: the whole site asks for it (user name "demo"); 12+ characters; without it a production demo server turns every request away
ALERTS_TRANSPORT=console               # console | none  (alerts to the founder; the phone sender comes later)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=                   # e.g. whatsapp:+44...
TWILIO_SMS_FROM=                        # e.g. +44...

# --- Web push (keys from the project's own copy: node_modules/.bin/web-push generate-vapid-keys) ---
PUSH_TRANSPORT=console                  # console (prints) | none | webpush (needs all three keys; refused in tests)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain

# --- Email (the worker only; any provider over SMTP: docs/office-v2.md 5.8) ---
EMAIL_TRANSPORT=console                 # console | smtp  (console is refused in production; never smtp in tests)
SMTP_HOST=
SMTP_PORT=587                           # 465 means TLS from the start; any other port must offer STARTTLS
SMTP_USER=
SMTP_PASS=
# The address email comes from, on a domain your provider has verified (e.g. shifts@ your domain).
SMTP_FROM=

# --- AI (the worker only; Claude through the Anthropic API, off by default) ---
AI_TRANSPORT=none                       # none | anthropic  (never anthropic in tests)
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5

# --- Postcodes and travel times (the web app and the worker: docs/office-v2.md 5.4) ---
TRAVEL_PROVIDER=fake                    # fake | traveltime  (fake knows only the made-up ZZ postcodes; never traveltime in tests)
TRAVELTIME_APP_ID=                      # worker only, with traveltime (from TravelTime's developer portal)
TRAVELTIME_API_KEY=

# --- The worker on a server (set by deploy/docker-compose.yml there; not needed locally) ---
# HEALTH_CHECK_URL=http://web:3000/api/health      # the ops alerts check the web app at this address
# WORKER_HEARTBEAT_FILE=/tmp/shiftdesk-worker-alive # its container's health check reads this

# --- Google Sheets plug ---
SHEETS_TRANSPORT=none                   # google once there's a Google account (PLAN.md Parking lot)
# GOOGLE_SERVICE_ACCOUNT_JSON_PATH=./secrets/google-service-account.json   # needed for SHEETS_TRANSPORT=google

# --- Stage 2 (optional) ---
ELEVENLABS_API_KEY=
