# The server's /opt/shiftdesk/.env (docs/runbooks.md "Deploy"): every value deploy/docker-compose.yml
# uses. Copy it there, fill it in, then `chmod 600 .env` (root only). Never commit the filled-in
# file. A value with $, # or spaces in it goes in single quotes.

# The image GitHub Actions builds (.github/workflows/deploy.yml): ghcr.io/<owner>/<repo>, lowercase.
SHIFTDESK_IMAGE=ghcr.io/owner/repo
# "main" for the latest; a commit's SHA to pin one (docs/runbooks.md "Rollback").
SHIFTDESK_TAG=main

# Our domain: firms get <slug>.<this>. No port.
APP_BASE_DOMAIN=shiftdesk.co.uk
# For Let's Encrypt's notices about certificates.
ACME_EMAIL=you@yourdomain

# 32+ random characters: openssl rand -base64 32
SESSION_SECRET=

# The database (deploy/lightsail.sh prints its address). The owner's password is the one AWS made
# (percent-encode #, ?, % in these addresses). The app and jobs passwords are new ones you choose
# (openssl rand -hex 24): the migrate step creates those two roles with them.
DATABASE_ADMIN_URL=postgres://shiftdesk_owner:OWNER_PASSWORD@DB_ADDRESS:5432/shiftdesk
DATABASE_URL=postgres://shiftdesk_app:APP_PASSWORD@DB_ADDRESS:5432/shiftdesk
DATABASE_JOBS_URL=postgres://shiftdesk_jobs:JOBS_PASSWORD@DB_ADDRESS:5432/shiftdesk

# The job worker: off until the Twilio sender exists ("console" messaging is refused in production,
# by design, so it couldn't start). Then set COMPOSE_PROFILES=worker, MESSAGING_TRANSPORT=twilio
# and the Twilio values (PLAN.md Parking lot, "Connect Twilio"). Until then web and Caddy run.
COMPOSE_PROFILES=
MESSAGING_TRANSPORT=
TWILIO_AUTH_TOKEN=

# Web push: none until the real sender is connected.
PUSH_TRANSPORT=none
VAPID_PUBLIC_KEY=
# Google Sheets: none until "Connect the real Google Sheets" (PLAN.md Parking lot); then google,
# with the key file in secrets/ next to this file (the worker sees it at /app/secrets).
SHEETS_TRANSPORT=none
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=
# Alerts to you (docs/runbooks.md "Alerts from the app"): "console" writes them in the log
# (docker compose logs web worker | grep "ops alert") until the phone sender is connected
# (PLAN.md Parking lot, "Connect alerts to your phone").
ALERTS_TRANSPORT=console
