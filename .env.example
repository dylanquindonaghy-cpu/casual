# --- App ---
NODE_ENV=development
APP_BASE_DOMAIN=localhost:3000          # prod: your domain, firms get <slug>.<domain>
SESSION_SECRET=change-me-32-bytes-min
MAGIC_LINK_TTL_MINUTES=15
OTP_TTL_MINUTES=10

# --- Database ---
DATABASE_URL=postgres://shiftdesk:shiftdesk@localhost:5432/shiftdesk
DATABASE_URL_TEST=postgres://shiftdesk:shiftdesk@localhost:5432/shiftdesk_test

# --- Messaging ---
MESSAGING_TRANSPORT=console             # console | twilio  (never twilio in tests)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=                   # e.g. whatsapp:+44...
TWILIO_SMS_FROM=                        # e.g. +44...

# --- Web push (generate with: npx web-push generate-vapid-keys) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain

# --- AWS (London) ---
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_SORT=                     # EU inference profile ID for Claude Haiku (check Bedrock console)
BEDROCK_MODEL_DRAFT=                    # EU inference profile ID for Claude Sonnet (Stage 2)
SES_FROM=shifts@yourdomain

# --- Google Sheets plug ---
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=./secrets/google-service-account.json

# --- Stage 2 (optional) ---
ELEVENLABS_API_KEY=
