# The demo server's /opt/shiftdesk/.env (16.2; docs/runbooks.md "A demo server"): every value
# docker-compose.yml and docker-compose.demo.yml use. Copy it there as .env, fill in the empty ones,
# then `chmod 600 .env` (root only). Never commit the filled-in file. A demo server holds the
# made-up demo only: never real people's data (golden rule 7; it refuses them).

# Both compose files, for every `docker compose` command in /opt/shiftdesk (deploy.sh's too): the
# demo's own database, demo mode and its password. Keep it as it is.
COMPOSE_FILE=docker-compose.yml:docker-compose.demo.yml

# The image GitHub Actions builds (.github/workflows/deploy.yml): ghcr.io/<owner>/<repo>, lowercase.
SHIFTDESK_IMAGE=ghcr.io/owner/repo
# "main" for the latest.
SHIFTDESK_TAG=main

# Your domain, without https:// or a port: the demo firms are acme.<this> and northline.<this>.
APP_BASE_DOMAIN=
# Your email address, for Let's Encrypt's notices about the site's certificates.
ACME_EMAIL=

# The password for the whole site (the user name is "demo"): 12 characters or more. You give it
# to the people you show the demo to. Letters, digits and spaces are easiest to type on a phone;
# with $, # or quotes in it, put the whole value in single quotes.
DEMO_SITE_PASSWORD=

# 32+ random characters: openssl rand -base64 32
SESSION_SECRET=
# The planner API's secret (docs/runbooks.md "The planner integration secret"): a different 32+
# random characters, openssl rand -base64 32. Empty: the planner API answers 503 (the rest of the
# demo works without it).
INTEGRATIONS_SECRET=

# The demo database's three passwords, all different, each made with: openssl rand -hex 24
# (letters and digits only, so they go into the addresses below as they are).
DEMO_DB_PASSWORD=
DEMO_DB_APP_PASSWORD=
DEMO_DB_JOBS_PASSWORD=

# The database addresses, made from those passwords: keep them as they are. Postgres runs on this
# server, reached over a socket only (no network port, so no certificate is needed).
DATABASE_ADMIN_URL=postgres://postgres:${DEMO_DB_PASSWORD}@localhost/shiftdesk?host=/var/run/postgresql&options=-c%20role%3Dshiftdesk_owner
DATABASE_URL=postgres://shiftdesk_app:${DEMO_DB_APP_PASSWORD}@localhost/shiftdesk?host=/var/run/postgresql
DATABASE_JOBS_URL=postgres://shiftdesk_jobs:${DEMO_DB_JOBS_PASSWORD}@localhost/shiftdesk?host=/var/run/postgresql
