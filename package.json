{
  "name": "shiftdesk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "node --env-file-if-exists=.env --import tsx src/worker/index.ts",
    "sim:whatsapp": "node --env-file-if-exists=.env --import tsx scripts/sim.ts whatsapp",
    "sim:sms": "node --env-file-if-exists=.env --import tsx scripts/sim.ts sms",
    "sim:call": "node --env-file-if-exists=.env --import tsx scripts/sim.ts call",
    "walkthrough:files": "node --env-file-if-exists=.env --import tsx scripts/walkthrough-files.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e.mjs",
    "e2e:walkthrough": "playwright test -c playwright.walkthrough.config.ts",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "db:reset": "node --env-file-if-exists=.env --import tsx scripts/db-reset.ts",
    "import": "node --env-file-if-exists=.env --import tsx scripts/import.ts",
    "firm:line": "node --env-file-if-exists=.env --import tsx scripts/firm-line.ts",
    "firm:brand": "node --env-file-if-exists=.env --import tsx scripts/firm-brand.ts",
    "firm:domain": "node --env-file-if-exists=.env --import tsx scripts/firm-domain.ts",
    "firm:call-fallback": "node --import tsx scripts/firm-call-fallback.ts",
    "firm:create": "node --env-file-if-exists=.env --import tsx scripts/firm-create.ts",
    "firm:settings": "node --env-file-if-exists=.env --import tsx scripts/firm-settings.ts",
    "firm:sheet": "node --env-file-if-exists=.env --import tsx scripts/firm-sheet.ts",
    "firm:agreement": "node --env-file-if-exists=.env --import tsx scripts/firm-agreement.ts",
    "firm:check": "node --env-file-if-exists=.env --import tsx scripts/firm-check.ts",
    "firm:office-user": "node --env-file-if-exists=.env --import tsx scripts/firm-office-user.ts",
    "logs:scan": "node --import tsx scripts/logs-scan.ts",
    "ops:test-alert": "node --env-file-if-exists=.env --import tsx scripts/ops-test-alert.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@fontsource-variable/geist": "5.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "drizzle-orm": "^0.45.3",
    "next": "^16.3.8",
    "nodemailer": "10.0.15",
    "pdf-lib": "1.17.1",
    "pg": "^8.23.0",
    "pg-boss": "^12.35.0",
    "pg-connection-string": "^2.14.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "0.35.5",
    "tsx": "^4.23.15",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "exceljs": "4.4.0",
    "pdfjs-dist": "6.4.299",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    },
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
